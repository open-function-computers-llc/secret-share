PORT=8088
BASE_URL=http://localhost:8088

MAIL_OUTPUT=smtp # valid options are log|smtp
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=

RECIPIENTS=Person:john@example.com,Other Person:jane@example.com

# Branding. Paths are files on the server, relative to where the binary runs.
SITE_TITLE=Super Secure Secret Share
LOGO_PATH=./theme/logo.svg
LOGO_ALT=Open Function Computers
FAVICON_PATH=./theme/favicon.ico
THEME_COLOR=#1e1e1e # mobile browser chrome color
# all colors, fonts and sizes; copy theme/default.css to make your own
THEME_CSS_PATH=./theme/default.css
